# Site URL (reference)
VITE_SITE_URL=https://glossanddetail.com

# Telegram notifications (booking + quote forms)
# 1) Open @BotFather → /newbot → copy the bot token
# 2) Each recipient must open the bot and press Start
# 3) Get each chat id via @userinfobot
# 4) One id, or several separated by comma: 111,222
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# Supabase (booking calendar / slot locking)
# 1) Create a free project at https://supabase.com
# 2) Run SQL from supabase/schema.sql in the SQL Editor
# 3) Settings → API Keys → copy Project URL + Publishable key (sb_publishable_...)
#    Legacy anon key (eyJ...) also works via VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL= https://rxlrjruwjrvdnnaofrbx.supabase.co/rest/v1/
VITE_SUPABASE_PUBLISHABLE_KEY= sb_publishable_q0RFWKmIs9Xi91fxyezrMw_vhvhCjEz
VITE_SUPABASE_ANON_KEY=
