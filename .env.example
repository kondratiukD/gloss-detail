# Site URL (reference)
VITE_SITE_URL=https://kondratiukd.github.io/gloss-detail

# Telegram notifications (booking + quote forms)
# 1) Open @BotFather in Telegram → /newbot → copy the bot token
# 2) Start a chat with your bot (press Start)
# 3) Get your chat id via @userinfobot (or similar) and paste it below
# 4) Rebuild and redeploy after saving this file as `.env`
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
